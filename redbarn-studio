float trim_depth(vec2 px) {
  const float W = 256.0, H = 648.0;
  float frame = 20.0 - min(min(px.x, W - px.x), min(px.y, H - px.y));
  float rail = 12.0 - abs(px.y - H * 0.5);
  vec2 q = vec2(px.x - 20.0, mod(px.y, H * 0.5) - 20.0) / vec2(W - 40.0, H * 0.5 - 40.0);
  float len = length(vec2(W - 40.0, H * 0.5 - 40.0));
  float brace = 15.0 - min(abs(q.x - q.y), abs(q.x + q.y - 1.0)) * (W - 40.0) * (H * 0.5 - 40.0) / len;
  return max(max(frame, rail), brace);
