    def on_monitor(self, row, _param):
        # With it on you hear the mic, sounds included, so your own copy and its slider aren't used.
        self.my_volume_row.set_sensitive(not row.get_active())
        if row.get_active():
            self.monitor_process = start_monitor()
        elif self.monitor_process:
