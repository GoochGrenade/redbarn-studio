class PitchShifter:
    """Pitch and formant shifting through librubberband, which has no GStreamer element."""
    # Real-time, HighConsistency (allows live changes), FormantPreserved, ThreadingNever, R3 engine.
    OPTIONS = 0x1 | 0x4000000 | 0x1000000 | 0x10000 | 0x20000000
    BLOCK = 8192

    def __init__(self):
        self.wanted = self.applied = (1.0, 1.0)
        lib = self.lib = load_rubberband()
        if lib is None:
            return  # pitch voices pass audio through unchanged, and the app says why
        lib.rubberband_new.restype = ctypes.c_void_p
        lib.rubberband_new.argtypes = [ctypes.c_uint, ctypes.c_uint, ctypes.c_int, ctypes.c_double, ctypes.c_double]
        lib.rubberband_set_pitch_scale.argtypes = [ctypes.c_void_p, ctypes.c_double]
        lib.rubberband_set_formant_scale.argtypes = [ctypes.c_void_p, ctypes.c_double]
        lib.rubberband_set_max_process_size.argtypes = [ctypes.c_void_p, ctypes.c_uint]
        lib.rubberband_reset.argtypes = [ctypes.c_void_p]
        lib.rubberband_process.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint, ctypes.c_int]
        lib.rubberband_available.argtypes = [ctypes.c_void_p]
        lib.rubberband_retrieve.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint]
        lib.rubberband_retrieve.restype = ctypes.c_uint
        self.state = lib.rubberband_new(48000, 1, self.OPTIONS, 1.0, 1.0)
        lib.rubberband_set_max_process_size(self.state, self.BLOCK)
        self.input = (ctypes.c_float * self.BLOCK)()
        self.output = (ctypes.c_float * self.BLOCK)()
        self.input_ptr = (ctypes.c_void_p * 1)(ctypes.addressof(self.input))
        self.output_ptr = (ctypes.c_void_p * 1)(ctypes.addressof(self.output))
        self.wanted = self.applied = (1.0, 1.0)

    def want(self, pitch, formant):
        # Applied by process(): rubberband isn't safe to change from another thread mid-block.
        self.wanted = (pitch, formant)

    def process(self, data):
        if self.lib is None:
            return data
        pitch, formant = self.wanted
        if self.wanted != self.applied:
            if self.applied == (1.0, 1.0):
                self.lib.rubberband_reset(self.state)
            self.lib.rubberband_set_pitch_scale(self.state, pitch)
            # Rubberband's scale is relative to the pitch shift, so this gives formant overall.
            self.lib.rubberband_set_formant_scale(self.state, formant / pitch)
            self.applied = self.wanted
        if self.wanted == (1.0, 1.0):
            return data  # Normal skips the engine, and its delay, entirely
        samples = len(data) // 4
        ctypes.memmove(self.input, data, samples * 4)
        self.lib.rubberband_process(self.state, self.input_ptr, samples, 0)
        result = bytearray()
        while (available := self.lib.rubberband_available(self.state)) > 0:
            got = self.lib.rubberband_retrieve(self.state, self.output_ptr, min(available, self.BLOCK))
            result += bytes(self.output)[:got * 4]
        return bytes(result)


def attach_shifter(pipeline):
    shifter = pipeline.shifter = PitchShifter()
    source = pipeline.get_by_name("shifter_out")

    def forward(sink, pull):
        buffer = sink.emit(pull).get_buffer()
        output = shifter.process(buffer.extract_dup(0, buffer.get_size()))
        if output:
            source.push_buffer(Gst.Buffer.new_wrapped(output))
        return Gst.FlowReturn.OK

    # Preroll too: the pipeline won't start until the first audio reaches its final sink.
    sink = pipeline.get_by_name("shifter_in")
    sink.connect("new-preroll", forward, "pull-preroll")
    sink.connect("new-sample", forward, "pull-sample")


def set_voice(pipeline, name):
    voice = VOICES[name]
    delay_ms, intensity, feedback = voice.get("echo", (1, 0.0, 0.0))
    pitch = voice.get("pitch", 1.0)
    pipeline.shifter.want(pitch, voice.get("formant", pitch))
    pipeline.get_by_name("highpass").set_property("cutoff", voice.get("highpass", 20.0))
    pipeline.get_by_name("lowpass").set_property("cutoff", voice.get("lowpass", 20000.0))
    pipeline.get_by_name("drive").set_property("amplification", voice.get("drive", 1.0))
    echo = pipeline.get_by_name("echo")
    echo.set_property("delay", delay_ms * Gst.MSECOND)
    echo.set_property("intensity", intensity)
    echo.set_property("feedback", feedback)
    pipeline.get_by_name("reverb").set_property("level", voice.get("reverb", 0.0))


def stop(handle):
    """Stop a helper: a process on Linux, a GStreamer pipeline on Windows."""
    if not isinstance(handle, subprocess.Popen):
        handle.set_state(Gst.State.NULL)
        return
    handle.terminate()
    try:
        handle.wait(2)
    except subprocess.TimeoutExpired:
        handle.kill()


def running(handle):
    if isinstance(handle, subprocess.Popen):
        return handle.poll() is None
    return handle.get_bus().pop_filtered(Gst.MessageType.ERROR) is None


def start_monitor():
    """Play the virtual mic to the speakers, kept apart from what Discord receives."""
    if not WINDOWS:
        return subprocess.Popen(MONITOR_CMD, preexec_fn=die_with_parent)
    pipeline = Gst.parse_launch("wasapi2src name=src low-latency=true ! audioconvert ! wasapi2sink low-latency=true sync=false")
    pipeline.get_by_name("src").set_property("device", windows_device("Audio/Source", "device", "CABLE Output"))
    pipeline.set_state(Gst.State.PLAYING)
    return pipeline


def die_with_parent():
    ctypes.CDLL(None).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG: no silent mic left behind after a crash


def start_virtual_mic():
    """(helper to stop on exit, device the voice is written to), or (None, None) if there's no virtual mic."""
    if WINDOWS:
        return None, windows_device("Audio/Sink", "device", CABLE_INPUT)  # VB-CABLE, installed by the user
    # pw-loopback, not pipewiresink mode=provide: that makes a mic that lists fine but carries no audio.
    process = subprocess.Popen([
        "pw-loopback", "--name=redbarn",
        f'--capture-props=media.class=Audio/Sink node.name={OUTPUT_NODE} node.description="Redbarn Output" {MIC_PROPS}',
        f'--playback-props=media.class=Audio/Source node.name={MIC_NODE} node.description="{MIC_NAME}" {MIC_PROPS}',
    ], preexec_fn=die_with_parent)
    for _ in range(30):
        if OUTPUT_NODE in pactl("list", "short", "sinks"):
            return process, OUTPUT_NODE
        time.sleep(0.1)
    process.terminate()
    return None, None


def build_voice_pipeline(mic, output):
    pipeline = Gst.parse_launch(f"{MIC_SOURCE} ! {VOICE_CHAIN} ! {VOICE_SINK}")
    if mic:
        pipeline.get_by_name("mic").set_property("device", mic)
    pipeline.get_by_name("voice_out").set_property("device", output)
    attach_shifter(pipeline)
    set_voice(pipeline, "Normal")
    return pipeline


