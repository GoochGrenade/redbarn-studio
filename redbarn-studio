def set_overlay(pipeline, look, blink=True):
    rec, info, stamp = (pipeline.get_by_name(name) for name in ("rec", "info", "stamp"))
    style = OVERLAYS.get(look)
    rec.set_property("silent", style is None or not blink)
    info.set_property("silent", style is None)
