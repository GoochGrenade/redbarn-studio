RATE = 48000
BRASS = {1: 1.0, 2: 0.5, 3: 0.35, 4: 0.2, 5: 0.1}


def note(freq, seconds, partials={1: 1.0}, decay=0.0, glide=0.0, vibrato=0.0):
    """A tone with the given partials ({frequency ratio: level}), fading in and out over 10ms to avoid clicks."""
    samples, phase, count = [], 0.0, int(seconds * RATE)
    for i in range(count):
        t = i / RATE
        phase += 2 * math.pi * freq * (1 - glide * t / seconds) * (1 + vibrato * math.sin(2 * math.pi * 5 * t)) / RATE
        level = math.exp(-decay * t) * min(1, i / 480, (count - i) / 480)
        samples.append(level * sum(amount * math.sin(ratio * phase) for ratio, amount in partials.items()))
    return samples


def hiss(seconds, decay):
    noise = [random.uniform(-1, 1) for _ in range(int(seconds * RATE) + 1)]
    return [(b - a) * 0.5 * math.exp(-decay * i / RATE) for i, (a, b) in enumerate(zip(noise, noise[1:]))]  # differences: high-pass


def drum(freq):
    """A drum hit: a falling pitched body plus a burst of rattle."""
    return [body + 0.5 * rattle for body, rattle in zip(note(freq, 0.3, {1: 1.0, 1.5: 0.3}, decay=14, glide=0.4), hiss(0.3, 30))]


def cymbal(seconds=1.2):
    noise = hiss(seconds + 1 / RATE, 3.5)
    shimmer = note(3150, seconds, {1: 1.0, 1.47: 0.8, 2.09: 0.6, 2.71: 0.5}, decay=4)
    return [0.5 * (b - a) + 0.12 * ring for a, b, ring in zip(noise, noise[1:], shimmer)]  # differenced again: brighter


def horn(seconds):
    return [math.tanh(2.5 * (a + b)) for a, b in zip(note(466, seconds, BRASS), note(587, seconds, BRASS))]


# Original sounds, made here: each is a list of (start in seconds, samples).
SOUNDS = {
    "Air Horn": lambda: [(start, horn(length)) for start, length in ((0, 0.12), (0.17, 0.12), (0.34, 0.7))],
    "Ba-Dum-Tss": lambda: [(0, drum(220)), (0.17, drum(150)), (0.42, cymbal())],
    "Sad Trombone": lambda: [(i * 0.45, note(freq, 1.3 if i == 3 else 0.42, BRASS, vibrato=0.03 if i == 3 else 0))
                             for i, freq in enumerate((293.7, 277.2, 261.6, 246.9))],
    "Buzzer": lambda: [(0, note(110, 0.8, {1: 1.0, 3: 0.33, 5: 0.2, 7: 0.14}))],
    "Ding": lambda: [(0, note(880, 1.6, {1: 1.0, 2.76: 0.2, 5.4: 0.05}, decay=3))],
    "Crickets": lambda: [(group * 0.55 + pulse * 0.04, note(4500, 0.02)) for group in range(4) for pulse in range(3)],
}


def builtin_sound(name):
    """Path to the built-in sound's WAV file, made on first use."""
    path = os.path.join(BUILTIN_DIR, f"{name}.wav")
    if os.path.exists(path):
        return path
    parts = SOUNDS[name]()
    mix = [0.0] * max(int(start * RATE) + len(samples) for start, samples in parts)
    for start, samples in parts:
        for i, x in enumerate(samples, int(start * RATE)):
            mix[i] += x
    scale = 0.9 / max(abs(x) for x in mix)
    os.makedirs(BUILTIN_DIR, exist_ok=True)
    with wave.open(path + ".part", "wb") as out:
        out.setnchannels(1)
        out.setsampwidth(2)
        out.setframerate(RATE)
        out.writeframes(array.array("h", (int(x * scale * 32767) for x in mix)).tobytes())  # little-endian on x86
    os.replace(path + ".part", path)
    return path


def user_sounds():
    try:
        names = sorted(os.listdir(SOUNDS_DIR), key=str.lower)
    except FileNotFoundError:
        return []
    return [os.path.join(SOUNDS_DIR, name) for name in names if name.lower().endswith(SOUND_TYPES)]


def play_sound(path, sink, volume, device=None):
    player = Gst.ElementFactory.make("playbin")
    # Audio only: an MP3's cover art would otherwise open a video window. soft-volume keeps the volume working on any sink.
    Gst.util_set_object_arg(player, "flags", "audio+soft-volume")
    player.set_property("uri", Gst.filename_to_uri(path))
    output = Gst.parse_bin_from_description(sink, True)
    if device:
        output.get_by_name("out").set_property("device", device)
    player.set_property("audio-sink", output)
    player.set_property("volume", volume)
    player.set_state(Gst.State.PLAYING)
    return player


def load_settings():
    """Saved settings, or {} if there are none or the file is damaged."""
    try:
        with open(SETTINGS_FILE, encoding="utf-8") as f:
            settings = json.load(f)
    except (OSError, ValueError):
        return {}
    return settings if isinstance(settings, dict) else {}


def save_settings(settings):
    os.makedirs(os.path.dirname(SETTINGS_FILE), exist_ok=True)
    with open(SETTINGS_FILE + ".part", "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2)
    os.replace(SETTINGS_FILE + ".part", SETTINGS_FILE)  # a crash mid-write can't leave a half-written file


