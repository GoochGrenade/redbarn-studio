# One shader with a mode uniform: glshader ignores new fragment source while
# playing, and restarting the pipeline would drop the camera from Discord.
SHADER = """varying vec2 v_texcoord;
uniform sampler2D tex;
uniform float time;
uniform float mode;

const vec2 PX = vec2(1.0 / 1280.0, 1.0 / 720.0);

float rand(vec2 p) {
  return fract(sin(dot(p, vec2(12.9898, 78.233)) + fract(time) * 311.7) * 43758.5453);
}
float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
float grain(vec2 uv, float amount) { return (rand(uv) - 0.5) * amount; }
float vignette(vec2 uv, float amount) {
  vec2 d = uv - 0.5;
  return clamp(1.0 - dot(d, d) * 2.0 * amount, 0.0, 1.0);
}
float scanlines(vec2 uv, float lines, float amount) {
  return 1.0 - amount * step(0.5, fract(uv.y * lines));
}
vec3 get(vec2 uv) { return texture2D(tex, uv).rgb; }

vec3 night_vision(vec2 uv) {
  float g = pow(luma(get(uv)), 0.6) * 1.5 + grain(uv, 0.22);
  return vec3(0.08, 1.0, 0.14) * g * vignette(uv, 1.4);
}
vec3 grainy_film(vec2 uv) {
  vec3 c = mix(vec3(0.07, 0.06, 0.05), vec3(1.0, 0.95, 0.85), get(uv));
  float flicker = 1.0 + 0.025 * sin(time * 37.0);
  return (c + grain(uv, 0.16)) * flicker * vignette(uv, 0.8);
}
vec3 hi_def(vec2 uv) {
  vec3 c = get(uv);
  vec2 o = PX * 1.5;
  vec3 blur = (get(uv + vec2(o.x, 0.0)) + get(uv - vec2(o.x, 0.0))
             + get(uv + vec2(0.0, o.y)) + get(uv - vec2(0.0, o.y))) * 0.25;
  c += (c - blur) * 1.3;
  c = (c - 0.5) * 1.15 + 0.5;
  return mix(vec3(luma(c)), c, 1.25);
}
vec3 webcam_2008(vec2 uv) {
  vec2 grid = vec2(320.0, 180.0);
  vec3 c = get((floor(uv * grid) + 0.5) / grid);
  c = floor(c * 20.0 + 0.5) / 20.0;
  c = pow(c, vec3(0.8)) * 1.15 * vec3(0.92, 1.0, 1.08);
  return c + grain(uv, 0.03);
}
vec3 vhs(vec2 uv) {
  uv.x += sin(uv.y * 30.0 + time * 3.0) * 0.0015;
  float band = abs(uv.y - fract(time * 0.13));
  if (band < 0.02) uv.x += 0.012;
  vec3 c = vec3(get(uv + vec2(0.004, 0.0)).r, get(uv).g, get(uv - vec2(0.004, 0.0)).b);
  c = mix(vec3(luma(c)), c, 0.8);
  c += grain(uv, band < 0.02 ? 0.35 : 0.06);
  return c * scanlines(uv, 240.0, 0.12);
}
vec3 noir(vec2 uv) {
  float g = smoothstep(0.1, 0.85, luma(get(uv))) + grain(uv, 0.1);
  return vec3(g) * vignette(uv, 1.0);
}
vec3 cctv(vec2 uv) {
  vec3 c = get(uv);
  c = mix(vec3(luma(c)), c, 0.15) * vec3(0.92, 1.0, 0.96);
  c = (c - 0.5) * 1.2 + 0.5 + grain(uv, 0.12);
  return c * scanlines(uv, 288.0, 0.14) * vignette(uv, 1.3);
}
vec3 camcorder(vec2 uv) {
  vec2 o = PX * 1.2;
  vec3 c = (get(uv + vec2(o.x, 0.0)) + get(uv - vec2(o.x, 0.0))
          + get(uv + vec2(0.0, o.y)) + get(uv - vec2(0.0, o.y)) + get(uv) * 4.0) * 0.125;
  c.r = get(uv + vec2(0.0015, 0.0)).r;
  c = pow(c, vec3(0.9)) * vec3(1.06, 1.0, 0.92) + grain(uv, 0.05);
  c *= scanlines(uv, 480.0, 0.08);
  vec2 d = abs(uv - 0.5);
  bool arm_x = abs(d.y - 0.484) < 0.002 && d.x > 0.43 && d.x < 0.485;
  bool arm_y = abs(d.x - 0.485) < 0.0012 && d.y > 0.40 && d.y < 0.486;
  return arm_x || arm_y ? vec3(0.95) : c;
}
vec3 thermal(vec2 uv) {
  vec2 o = PX * 3.0;
  float t = luma(get(uv) + get(uv + o) + get(uv - o) + get(uv + vec2(o.x, -o.y))) * 0.25;
  t = pow(clamp(t, 0.0, 1.0), 0.7);
  vec3 c = mix(vec3(0.02, 0.0, 0.25), vec3(0.6, 0.0, 0.7), smoothstep(0.0, 0.33, t));
  c = mix(c, vec3(1.0, 0.35, 0.0), smoothstep(0.33, 0.66, t));
  return mix(c, vec3(1.0, 1.0, 0.6), smoothstep(0.66, 1.0, t));
}
vec3 silent_film(vec2 uv) {
  uv.y += (rand(vec2(1.0, 7.0)) - 0.5) * 0.006;
  float g = (pow(luma(get(uv)), 0.7) - 0.5) * 1.2 + 0.58 + grain(uv, 0.14);
  float scratch = 1.0 - step(abs(uv.x - rand(vec2(1.0, 2.0))), 0.0008) * step(0.6, rand(vec2(3.0, 4.0))) * 0.6;
  float dust = 1.0 - step(0.9995, rand(floor(uv * vec2(320.0, 180.0)))) * 0.8;
  float flicker = 1.0 + 0.06 * sin(time * 40.0);
  return vec3(1.0, 0.86, 0.62) * g * scratch * dust * flicker * vignette(uv, 0.8);
}
vec3 blockbuster(vec2 uv) {
  if (abs(uv.y - 0.5) > 0.372) return vec3(0.0);
  vec3 c = clamp(get(uv), 0.0, 1.0);
  float l = luma(c);
  c = mix(c, c * c * (3.0 - 2.0 * c), 0.6);
  c *= mix(vec3(0.85, 1.0, 1.1), vec3(1.12, 1.0, 0.82), smoothstep(0.2, 0.7, l));
  return mix(vec3(luma(c)), c, 1.15);
}
float barn_noise(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);  // no time: wood mustn't shimmer
}
float wood_grain(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(barn_noise(i), barn_noise(i + vec2(1.0, 0.0)), f.x),
             mix(barn_noise(i + vec2(0.0, 1.0)), barn_noise(i + vec2(1.0, 1.0)), f.x), f.y);
}
float fbm(vec2 p) {
  float v = 0.0, amp = 0.5;
  for (int i = 0; i < 4; i++) {
    v += amp * wood_grain(p);
    p *= 2.03;
    amp *= 0.5;
  }
  return v;
}
// Positive inside a trim board, measured in pixels to its nearest edge. Door is 256 x 648 px.
float trim_depth(vec2 px) {
  const float W = 256.0, H = 648.0;
  float frame = 20.0 - min(min(px.x, W - px.x), min(px.y, H - px.y));
  float rail = 12.0 - abs(px.y - H * 0.5);
  vec2 q = vec2(px.x - 20.0, mod(px.y, H * 0.5) - 20.0) / vec2(W - 40.0, H * 0.5 - 40.0);
  float len = length(vec2(W - 40.0, H * 0.5 - 40.0));
  float brace = 15.0 - min(abs(q.x - q.y), abs(q.x + q.y - 1.0)) * (W - 40.0) * (H * 0.5 - 40.0) / len;
  return max(max(frame, rail), brace);
}
vec3 barn_door(vec2 d, float side) {
  vec2 px = d * vec2(256.0, 648.0);
  vec2 seed = vec2(side * 37.0, side * 11.0);
  float plank = floor(d.x * 5.0);
  float fx = fract(d.x * 5.0);
  float grain = fbm(vec2(px.x * 0.3 + plank * 13.0, px.y * 0.01) + seed);
  float wear = fbm(px * 0.035 + seed + 50.0);
  float seam = smoothstep(0.0, 0.035, fx) * smoothstep(0.0, 0.035, 1.0 - fx);

  vec3 paint = vec3(0.55, 0.11, 0.08) * (0.82 + 0.28 * barn_noise(vec2(plank, 3.0) + seed)) * (0.72 + 0.45 * grain);
  paint = mix(paint, paint * 1.18 + vec3(0.05, 0.03, 0.03), smoothstep(0.45, 0.0, d.y) * 0.5);  // sun-faded top
  vec3 bare = vec3(0.5, 0.44, 0.37) * (0.7 + 0.45 * grain);
  // Worn spots gather low down and along plank edges, where real paint fails first.
  float chipped = smoothstep(0.74, 0.77, wear + 0.14 * d.y * d.y + 0.1 * abs(fx - 0.5));
  float depth = trim_depth(px);
  vec3 c;
  if (depth > 0.0) {
    vec3 white = vec3(0.83, 0.79, 0.7) * (0.74 + 0.32 * grain);
    white = mix(white, bare, smoothstep(0.76, 0.8, wear + 0.12 * d.y * d.y) * 0.7);
    c = white * mix(0.62, 1.0, smoothstep(0.0, 4.0, depth));  // bevelled board edges
  } else {
    c = mix(paint, bare, chipped) * mix(0.22, 1.0, seam);
    c *= trim_depth(px + vec2(-5.0, -6.0)) > 0.0 ? 0.55 : 1.0;  // trim casts a shadow onto the planks
  }
  c *= mix(vec3(1.0), vec3(0.72, 0.62, 0.5), smoothstep(0.82, 1.0, d.y));  // dirt near the ground
  c *= mix(0.55, 1.08, d.x);  // light comes from the doorway, so the outer side is darker
  c *= mix(0.45, 1.0, smoothstep(1.0, 0.985, d.x));  // door thickness on the inner edge

  for (float h = 0.0; h < 2.0; h += 1.0) {  // hanger straps up to the track, with bolts
    float hx = 64.0 + h * 128.0;
    if (abs(px.x - hx) < 9.0 && px.y < 46.0) {
      vec3 iron = vec3(0.09, 0.09, 0.1) * (0.8 + 0.4 * grain);
      for (float b = 0.0; b < 2.0; b += 1.0) {
        float bolt = length(px - vec2(hx, 14.0 + b * 20.0));
        iron = mix(iron, vec3(0.35, 0.33, 0.3), smoothstep(3.5, 2.0, bolt));
        iron = mix(iron, vec3(0.7, 0.66, 0.6), smoothstep(1.6, 0.4, length(px - vec2(hx - 1.0, 13.0 + b * 20.0))));
      }
      c = iron;
    }
  }
  return c;
}
vec3 red_barn(vec2 uv) {
  const float door = 0.2, beam = 0.1;
  if (uv.y < beam) {
    float grain = fbm(vec2(uv.x * 9.0, uv.y * 90.0));
    float crack = smoothstep(0.03, 0.0, abs(fract(uv.y * 31.0 + fbm(vec2(uv.x * 4.0, 2.0)) * 0.8) - 0.5) - 0.47);
    vec3 wood = vec3(0.36, 0.23, 0.13) * (0.5 + 0.85 * grain) * (1.0 - 0.55 * crack);
    wood *= mix(0.7, 1.0, uv.y / beam);
    if (uv.y > beam - 0.022 && uv.y < beam - 0.006) {  // iron sliding-door track
      wood = vec3(0.08, 0.08, 0.09) + vec3(0.22, 0.21, 0.2) * smoothstep(0.003, 0.0, abs(uv.y - (beam - 0.019)));
    }
    return wood;
  }
  float y = (uv.y - beam) / (1.0 - beam);
  if (uv.x < door) return barn_door(vec2(uv.x / door, y), 0.0);
  if (uv.x > 1.0 - door) return barn_door(vec2((1.0 - uv.x) / door, y), 1.0);
  vec3 c = pow(clamp(get(uv), 0.0, 1.0), vec3(0.82)) * vec3(1.14, 0.98, 0.72);
  c = mix(c, vec3(0.9, 0.66, 0.36), 0.1);
  float shade = smoothstep(door - 0.02, door + 0.15, uv.x) * smoothstep(1.0 - door + 0.02, 1.0 - door - 0.15, uv.x)
              * smoothstep(beam - 0.02, beam + 0.16, uv.y);
  c *= mix(0.5, 1.0, shade);
  float rays = smoothstep(0.55, 1.0, sin((uv.x + uv.y * 0.55) * 15.0 + fbm(vec2(uv.x * 3.0, 1.0)) * 4.0) * 0.5 + 0.5);
  c += vec3(1.0, 0.8, 0.5) * rays * 0.06 * (1.0 - uv.y);  // soft light shafts through the doorway
  for (float layer = 1.0; layer < 3.0; layer += 1.0) {
    vec2 p = uv * vec2(16.0, 9.0) * layer + vec2(sin(time * 0.12 + layer) * 0.5, time * 0.07 * layer);
    vec2 cell = floor(p);
    vec2 centre = vec2(barn_noise(cell), barn_noise(cell + 5.0)) * 0.6 + 0.2;
    float mote = smoothstep(0.05, 0.0, length(fract(p) - centre)) * step(0.72, barn_noise(cell + layer));
    c += vec3(1.0, 0.84, 0.55) * mote * 0.25;
  }
  return c;
}

void main() {
  vec2 uv = v_texcoord;
  vec3 c;
  if (mode < 0.5) c = get(uv);
  else if (mode < 1.5) c = night_vision(uv);
  else if (mode < 2.5) c = grainy_film(uv);
  else if (mode < 3.5) c = hi_def(uv);
  else if (mode < 4.5) c = webcam_2008(uv);
  else if (mode < 5.5) c = vhs(uv);
  else if (mode < 6.5) c = noir(uv);
  else if (mode < 7.5) c = cctv(uv);
  else if (mode < 8.5) c = camcorder(uv);
  else if (mode < 9.5) c = thermal(uv);
  else if (mode < 10.5) c = silent_film(uv);
  else if (mode < 11.5) c = blockbuster(uv);
  else c = red_barn(uv);
  gl_FragColor = vec4(c, 1.0);
}
