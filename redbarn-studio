    def set_status(self, pill, level, text, problem=None):
        pill.set_text(f"● {text}")
        pill.set_css_classes(["pill", level])
        self.problems[pill] = problem
        problems = [p for p in self.problems.values() if p]
        self.banner.set_title(" ".join(problems))
        self.banner.set_revealed(bool(problems))

    def camera_off(self, reason):
        self.set_status(self.status, "stopped", "Camera off", reason)

    def start(self):
        cam, loopback = find_webcam(), find_loopback()
        if not cam:
            self.camera_off(f"No webcam found. Plug it in, then reopen {APP_NAME}.")
            return
        if not loopback:
            self.camera_off("Virtual camera not found. Run redbarn-studio --check for setup help.")
            return
        loopback_path, loopback_name = loopback
        self.camera_group.set_description(f"In Discord, choose “{GLib.markup_escape_text(loopback_name)}”.")
        try:
            self.pipeline = build_camera_pipeline(cam, loopback_path)
        except GLib.Error as e:
            self.camera_off(f"Couldn't set up video: {e.message}")
            return
        except RuntimeError as e:  # Windows: OBS's virtual camera is missing or busy
            self.camera_off(f"Couldn't start the virtual camera: {e} {WINDOWS_HELP['obs']}")
            return
        self.pipeline.get_by_name("preview").connect("new-sample", self.on_preview)
        bus = self.pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_error)
        self.pipeline.set_state(Gst.State.PLAYING)
        GLib.timeout_add(500, self.tick)
        self.set_status(self.status, "live", "Camera live")

    def start_voice(self):
        # Separate from the camera on purpose: a mic problem must not stop the video, or the reverse.
        try:
            mic = find_mic()
            if not mic:
                self.voice_off("No microphone found, so voice filters are off.")
                return
            self.virtual_mic, output = start_virtual_mic()
            if not output:
                help_text = f" {WINDOWS_HELP['cable']}" if WINDOWS else ""
                self.voice_off(f"Couldn't create the virtual mic, so voice filters are off.{help_text}")
                return
            self.voice_pipeline = build_voice_pipeline(mic, output)
        except (GLib.Error, OSError, subprocess.SubprocessError) as e:
            self.voice_off(f"Voice filters are off: {e}")
            return
        bus = self.voice_pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_voice_error)
        self.voice_pipeline.get_by_name("mic").get_static_pad("src").add_probe(Gst.PadProbeType.BUFFER, self.on_mic_audio)
        self.last_mic_audio = time.monotonic()
        self.voice_pipeline.set_state(Gst.State.PLAYING)
        self.set_status(self.voice_status, "live", "Mic live")
        GLib.timeout_add_seconds(1, self.check_mic)

    def on_mic_audio(self, _pad, _info):
        self.last_mic_audio = time.monotonic()
        return Gst.PadProbeReturn.OK

    def check_mic(self):
        # A missing mic raises no error: pulsesrc just waits, and Discord would get silence.
        if not self.voice_pipeline:
            return False
        if self.monitor_process and not running(self.monitor_process):
            self.monitor.set_active(False)
        voice = VOICES[list(VOICES)[self.voice_menu.get_selected()]]
        if time.monotonic() - self.last_mic_audio > 2:
            self.set_status(self.voice_status, "warn", "No mic audio", MIC_LOST)
        elif self.voice_pipeline.shifter.lib is None and ("pitch" in voice or "formant" in voice):
            self.set_status(self.voice_status, "warn", "Voice unavailable", RUBBERBAND_MISSING)
        else:
            self.set_status(self.voice_status, "live", "Mic live")
        return True

    def voice_off(self, reason):
        self.voice_menu.set_sensitive(False)
        self.monitor.set_active(False)
        self.monitor.set_sensitive(False)
        self.set_status(self.voice_status, "stopped", "Mic off", reason)

    def on_preview(self, sink):
        buffer = sink.emit("pull-sample").get_buffer()
        GLib.idle_add(self.show_preview, GLib.Bytes.new(buffer.extract_dup(0, buffer.get_size())))
        return Gst.FlowReturn.OK

    def show_preview(self, pixels):
        self.picture.set_paintable(Gdk.MemoryTexture.new(
            PREVIEW_WIDTH, PREVIEW_HEIGHT, Gdk.MemoryFormat.R8G8B8A8, pixels, PREVIEW_WIDTH * 4))
        return False

    def tick(self):
        self.blink = not self.blink
        set_overlay(self.pipeline, self.look, self.blink)
        return True

    def on_look(self, menu, _param):
        self.look = LOOKS[menu.get_selected()]
        if self.pipeline:
            set_look(self.pipeline.get_by_name("fx"), self.look)
            set_overlay(self.pipeline, self.look, self.blink)

    def on_voice(self, menu, _param):
        if self.voice_pipeline:
            set_voice(self.voice_pipeline, list(VOICES)[menu.get_selected()])
            self.check_mic()

    def on_mirror(self, row, _param):
        if self.pipeline:
            set_text_mirrored(self.pipeline, row.get_active())

    def on_flip_camera(self, row, _param):
        if self.pipeline:
            set_camera_flipped(self.pipeline, row.get_active())

    def on_monitor(self, row, _param):
        if row.get_active():
            self.monitor_process = start_monitor()
        elif self.monitor_process:
            stop(self.monitor_process)
            self.monitor_process = None

    def on_dark(self, row, _param):
        dark = row.get_active()
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK if dark else Adw.ColorScheme.FORCE_LIGHT)
        # Our own colours need this class: CSS media queries don't follow a forced colour scheme.
        (self.get_active_window().add_css_class if dark else self.get_active_window().remove_css_class)("dark-ui")

    def on_error(self, _bus, message):
        self.camera_off(error_hint(message))
        self.pipeline.set_state(Gst.State.NULL)

    def on_voice_error(self, _bus, message):
        self.voice_off(f"Voice filters stopped: {message.parse_error()[0].message}. The camera is unaffected.")
        self.voice_pipeline.set_state(Gst.State.NULL)
        self.voice_pipeline = None

    def on_close(self, _window):
        for handle in (self.pipeline, self.voice_pipeline, self.monitor_process, self.virtual_mic):
            if handle:
                stop(handle)
        if getattr(self.pipeline, "virtual_camera", None):
            self.pipeline.virtual_camera.close()
        return False


def pull_bytes(sink):
    sample = sink.emit("try-pull-sample", 2 * Gst.SECOND)
    assert sample, "no frame arrived"
    buffer = sample.get_buffer()
    ok, info = buffer.map(Gst.MapFlags.READ)
    assert ok, "couldn't read frame"
    data = bytes(info.data)
    buffer.unmap(info)
    return data


def pull_frame(sink):
    """Mean-comparable pixel samples from the newest frame, as (r, g, b) tuples."""
    data = pull_bytes(sink)
    return [tuple(data[i:i + 3]) for i in range(0, len(data), 4 * 211)]


def red_dot_pixels(sink, side="right"):
    """Counts strongly red pixels in a top 100x100 corner: the record dot is on the right when mirrored."""
    data = pull_bytes(sink)
    left = 1180 if side == "right" else 0
    pixels = (data[(y * 1280 + x) * 4:(y * 1280 + x) * 4 + 3] for y in range(100) for x in range(left, left + 100))
    return sum(r > 150 and g < 90 and b < 90 for r, g, b in pixels)


def mean(frame, channel=None):
    values = [sum(p) / 3 if channel is None else p[channel] for p in frame]
    return sum(values) / len(values)


def difference(a, b):
    return sum(abs(x - y) for p, q in zip(a, b) for x, y in zip(p, q)) / (3 * len(a))


def listen(sink, seconds=0.3):
    """Left-channel samples arriving after this call, for measuring a voice."""
    while sink.emit("try-pull-sample", 0):
        pass
    samples = []
    while len(samples) < seconds * 48000:
        sample = sink.emit("try-pull-sample", 2 * Gst.SECOND)
        assert sample, "no audio arrived"
        buffer = sample.get_buffer()
        ok, info = buffer.map(Gst.MapFlags.READ)
        assert ok, "couldn't read audio"
        samples += struct.unpack(f"<{len(info.data) // 4}f", bytes(info.data))[::2]
        buffer.unmap(info)
    return samples


def tone_frequency(samples):
    crossings = sum(1 for a, b in zip(samples, samples[1:]) if a < 0 <= b)
    return crossings / (len(samples) / 48000)


def peak(samples):
    return max(abs(x) for x in samples)


def check_voices():
    """Synthetic tone only: no mic or virtual devices are touched."""
    pipeline = Gst.parse_launch(
        f"audiotestsrc name=tone is-live=true freq=440 volume=0.4 samplesperbuffer=480 ! {VOICE_CHAIN} "
        "! appsink name=sink sync=false drop=true max-buffers=50"
    )
    tone, sink = pipeline.get_by_name("tone"), pipeline.get_by_name("sink")
    attach_shifter(pipeline)
    set_voice(pipeline, "Normal")
    pipeline.set_state(Gst.State.PLAYING)

    def voice_at(name, frequency=440):
        tone.set_property("freq", float(frequency))
        set_voice(pipeline, name)
        time.sleep(0.7)
        return listen(sink)

    pitched = load_rubberband() is not None
    if not pitched:
        print("Rubber Band isn't installed: skipping the pitch voices")
    for name, expected in (("Normal", 440), ("Deep", 330), ("Chipmunk", 704), ("Child", 748), ("Female", 660),
                           ("Male", 352), ("Robot", 405), ("Demon", 273), ("Alien", 528), ("Ghost", 466),
                           ("Ghostface", 343), ("Normal", 440)):
        if not pitched and "pitch" in VOICES[name]:
            continue
        measured = tone_frequency(voice_at(name))
        print(f"{name:14} {expected}Hz expected, measured {measured:.0f}Hz")
        assert abs(measured - expected) < expected * 0.04, f"{name} is at the wrong pitch"

    for frequency in (100, 1000, 6000):
        normal, radio = peak(voice_at("Normal", frequency)), peak(voice_at("Walkie-Talkie", frequency))
        print(f"Walkie-Talkie  {frequency}Hz: {radio:.3f} vs Normal {normal:.3f}")
        if frequency == 1000:
            assert radio > normal, "Walkie-Talkie lost the speech band"
        else:
            assert radio < normal * 0.25, "Walkie-Talkie isn't narrowing the sound"

    tails = {}
    for name in ("Normal", "Cave", "Ghost"):
        voice_at(name)
        tone.set_property("volume", 0.0)
        time.sleep(0.35)
        tails[name] = peak(listen(sink, 0.1))
        tone.set_property("volume", 0.4)
    print(f"Echo tail 0.35s after sound stops: Cave {tails['Cave']:.4f}, Ghost {tails['Ghost']:.4f}, Normal {tails['Normal']:.4f}")
    assert min(tails["Cave"], tails["Ghost"]) > 0.01 > 0.002 > tails["Normal"], "Cave or Ghost doesn't echo, or Normal does"

    message = pipeline.get_bus().pop_filtered(Gst.MessageType.ERROR)
    pipeline.set_state(Gst.State.NULL)
    assert not message, message.parse_error()[0].message if message else ""


def resonance_centre(name):
    """Where a voice-like sound's energy sits after a voice, in Hz, using the shifter directly."""
    resonance = [(k, 1 / (1 + ((k * 120 - 700) / 150) ** 2)) for k in range(1, 30)]
    source = [0.2 * sum(a * math.sin(2 * math.pi * k * 120 * i / 48000) for k, a in resonance) for i in range(48000)]
    shifter = PitchShifter()
    voice = VOICES[name]
    shifter.want(voice.get("pitch", 1.0), voice.get("formant", voice.get("pitch", 1.0)))
    output = b"".join(shifter.process(struct.pack("<480f", *source[i:i + 480])) for i in range(0, 47520, 480))
    samples = struct.unpack(f"<{len(output) // 4}f", output)[-12000:]
    # Measured on the shifted voice's own harmonics: a fixed grid misses them and skews the result.
    f0 = 120 * voice.get("pitch", 1.0)
    bands = []
    for frequency in (f0 * k for k in range(1, int(3000 / f0))):
        step = 2 * math.cos(2 * math.pi * frequency / 48000)
        a = b = 0.0
        for x in samples:
            a, b = x + step * a - b, a
        bands.append((frequency, a * a + b * b - step * a * b))
    return sum(f * p for f, p in bands) / sum(p for _, p in bands)


def check_formants():
    if load_rubberband() is None:
        return
    chipmunk, female, male = (resonance_centre(name) for name in ("Chipmunk", "Female", "Male"))
    print(f"Resonance: Chipmunk {chipmunk:.0f}Hz, Female {female:.0f}Hz, Male {male:.0f}Hz")
    assert female < chipmunk * 0.85, "Female's resonance moved with its pitch, so it will sound like Chipmunk"
    assert male < female * 0.9, "Male's resonance isn't lower than Female's"


def check_red_barn():
    pipeline = Gst.parse_launch(
        "videotestsrc is-live=true pattern=smpte75 ! video/x-raw,format=I420,width=1280,height=720,framerate=30/1 "
        f"! {FILTER_CHAIN} ! videoconvert ! video/x-raw,format=RGBA "
        "! appsink name=sink sync=false drop=true max-buffers=1"
    )
    fx, sink = pipeline.get_by_name("fx"), pipeline.get_by_name("sink")
    attach_shader(fx)
    set_look(fx, "Red Barn")
    pipeline.set_state(Gst.State.PLAYING)
    time.sleep(0.4)
    first = pull_bytes(sink)
    time.sleep(0.5)
    second = pull_bytes(sink)
    set_camera_flipped(pipeline, True)
    time.sleep(0.3)
    flipped = pull_bytes(sink)
    pipeline.set_state(Gst.State.NULL)

    def pixels(frame, left, right, top, bottom):
        return [frame[(y * 1280 + x) * 4:(y * 1280 + x) * 4 + 3] for y in range(top, bottom, 3) for x in range(left, right, 3)]

    def change(a, b):
        return sum(abs(p - q) for x, y in zip(a, b) for p, q in zip(x, y)) / (3 * len(a))

    door, opening = (20, 240, 100, 700), (300, 980, 150, 600)
    wood = pixels(first, *door)
    red = sum(p[0] for p in wood) / len(wood)
    green = sum(p[1] for p in wood) / len(wood)
    white = sum(min(p) > 130 for p in wood) / len(wood)
    beam = pixels(first, 300, 980, 10, 50)
    print(f"Red Barn: door red {red:.0f} vs green {green:.0f}, white trim {white:.0%}, beam red {sum(p[0] for p in beam) / len(beam):.0f}, "
          f"door shimmer {change(wood, pixels(second, *door)):.2f}, dust movement {change(pixels(first, *opening), pixels(second, *opening)):.2f}")
    assert red > green * 1.3, "Red Barn doors aren't red"
    assert 0.08 < white < 0.6, "Red Barn doors have no white bracing"
    assert sum(p[0] for p in beam) / len(beam) < 110, "Red Barn beam isn't at the top"
    assert change(wood, pixels(second, *door)) < 0.5, "Red Barn wood shimmers"
    assert change(pixels(first, *opening), pixels(second, *opening)) > 0.02, "Red Barn dust isn't moving"
    assert first[(360 * 1280 + 500) * 4 + 1] > 2 * first[(360 * 1280 + 1000) * 4 + 1], "Red Barn lost the camera picture"
    assert change(wood, pixels(flipped, *door)) < 0.5, "Flip camera moved the doors"
    assert change(pixels(first, *opening), pixels(flipped, *opening)) > 10, "Flip camera didn't reach the picture"


def check_picture_not_mirrored():
    # The gradient self_test uses looks the same mirrored; these colour bars are bright on the left.
    pipeline = Gst.parse_launch(
        "videotestsrc is-live=true pattern=smpte75 ! video/x-raw,format=I420,width=1280,height=720,framerate=30/1 "
        f"! {FILTER_CHAIN} ! videoconvert ! video/x-raw,format=RGBA "
        "! appsink name=sink sync=false drop=true max-buffers=1"
    )
    fx, sink = pipeline.get_by_name("fx"), pipeline.get_by_name("sink")
    attach_shader(fx)
    set_look(fx, "Clean")
    pipeline.set_state(Gst.State.PLAYING)
    time.sleep(0.4)
    mirrored = pull_bytes(sink)
    set_text_mirrored(pipeline, False)
    time.sleep(0.3)
    plain = pull_bytes(sink)
    set_camera_flipped(pipeline, True)
    time.sleep(0.3)
    flipped = pull_bytes(sink)
    pipeline.set_state(Gst.State.NULL)
    row = 360 * 1280 * 4
    assert flipped[row + 41] < 30 < 150 < flipped[row + 5041], "camera flip didn't mirror the picture"
    assert mirrored[row + 41] > 150 > 30 > mirrored[row + 5041], "picture is mirrored"
    changed = sum(abs(a - b) for a, b in zip(mirrored[::4 * 97], plain[::4 * 97])) / len(mirrored[::4 * 97])
    print(f"mirrored vs plain picture difference={changed:.2f}")
    assert changed < 1, "mirroring the text altered the picture"


def self_test():
    """Asserts on pixels: both failures this guards against raise no GStreamer error."""
    # gradient is static and dark at the top: smpte has animated snow, which fakes moving grain.
    pipeline = Gst.parse_launch(
        "videotestsrc is-live=true pattern=gradient ! video/x-raw,format=I420,width=1280,height=720,framerate=30/1 "
        f"! {FILTER_CHAIN} ! videoconvert ! video/x-raw,format=RGBA "
        "! appsink name=sink sync=false drop=true max-buffers=1"
    )
    fx, sink = pipeline.get_by_name("fx"), pipeline.get_by_name("sink")
    attach_shader(fx)
    set_look(fx, "Clean")
    pipeline.set_state(Gst.State.PLAYING)

    frames = {}
    for name in LOOKS:
        set_look(fx, name)
        set_overlay(pipeline, name)
        time.sleep(0.4)
        dot = red_dot_pixels(sink)
        # Red Barn's door is red where the dot would sit: check_red_barn covers that look.
        assert name == "Red Barn" or (dot > 30) == (name in OVERLAYS), f"{name} record dot is wrong: {dot} red pixels"
        frames[name] = pull_frame(sink)
        time.sleep(0.15)
        again = pull_frame(sink)
        moved = difference(frames[name], again)
        print(f"{name:13} brightness={mean(frames[name]):5.1f} "
              f"vs clean={difference(frames[name], frames['Clean']):5.1f} frame-to-frame={moved:5.2f}")
        assert mean(frames[name]) > 8, f"{name} is black"
        if name in GRAINY_LOOKS:
            assert moved > 1, f"{name} grain isn't moving"
        elif name == "Clean":
            assert moved < 0.5, "Clean is altering the image"

    set_look(fx, "CCTV")
    set_overlay(pipeline, "CCTV", blink=False)
    time.sleep(0.2)
    assert red_dot_pixels(sink) == 0, "record dot doesn't blink off"

    set_overlay(pipeline, "CCTV")
    set_text_mirrored(pipeline, False)
    time.sleep(0.2)
    assert red_dot_pixels(sink, "left") > 30 and red_dot_pixels(sink) == 0, "overlay didn't unmirror"

    message = pipeline.get_bus().pop_filtered(Gst.MessageType.ERROR)
    pipeline.set_state(Gst.State.NULL)
    assert not message, error_hint(message) if message else ""

    for name in LOOKS[1:]:
        assert difference(frames[name], frames["Clean"]) > 3, f"{name} didn't change the image"
    night = frames["Night Vision"]
    assert mean(night, 1) > 3 * max(mean(night, 0), mean(night, 2)), "Night Vision isn't green"
    silent = frames["Silent Film"]
    assert mean(silent, 0) > mean(silent, 1) > mean(silent, 2), "Silent Film isn't sepia"
    thermal = frames["Thermal"]
    assert sum(abs(r - b) for r, _, b in thermal) / len(thermal) > 20, "Thermal has no heat colours"
    blockbuster = frames["Blockbuster"]
    assert mean(blockbuster[:len(blockbuster) // 20]) < 2, "Blockbuster has no black bars"
    clean = frames["Clean"]
    assert mean(clean[:len(clean) // 2]) < mean(clean[len(clean) // 2:]), "image is upside down"
    check_picture_not_mirrored()
    check_red_barn()
    assert len(LOOKS) == len(VOICES), "Looks and voices should stay equal in number"
    check_voices()
    check_formants()
    print("self-test passed")


if __name__ == "__main__":
    Gst.init(None)
    if "--self-test" in sys.argv:
        self_test()
    else:
        sys.exit(RedbarnStudio().run([sys.argv[0]]))
