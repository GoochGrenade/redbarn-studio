    float grain = fbm(vec2(uv.x * 9.0, uv.y * 90.0));
    float crack = smoothstep(0.03, 0.0, abs(fract(uv.y * 31.0 + fbm(vec2(uv.x * 4.0, 2.0)) * 0.8) - 0.5) - 0.47);
    vec3 wood = vec3(0.36, 0.23, 0.13) * (0.5 + 0.85 * grain) * (1.0 - 0.55 * crack);
    wood *= mix(0.7, 1.0, uv.y / beam);
    if (uv.y > beam - 0.022 && uv.y < beam - 0.006) {  // iron sliding-door track
      wood = vec3(0.08, 0.08, 0.09) + vec3(0.22, 0.21, 0.2) * smoothstep(0.003, 0.0, abs(uv.y - (beam - 0.019)));
    }
    return wood;
