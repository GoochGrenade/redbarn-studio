def pactl(*args):
    # LC_ALL=C: `pactl list` labels like "Name:" are translated otherwise, and get parsed below.
    return subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=5,
                          env={**os.environ, "LC_ALL": "C"}).stdout.strip()


def windows_device(device_class, id_property, want=None):
    """ID of a Windows device: the first whose name contains `want` (a name or names, in order of preference),
    or else the default real one."""
    devices = windows_devices(device_class, real=not want)
    if want:
        wants = (want,) if isinstance(want, str) else want
        # VB-CABLE's 16-channel variant isn't the one Discord's "CABLE Output" mic carries.
        devices = [d for w in wants for d in devices if w in d.get_display_name() and "16 Ch" not in d.get_display_name()]
    return devices[0].create_element(None).get_property(id_property) if devices else None


def windows_devices(device_class, real=True):
    """Windows devices of a class, the default first.

    With `real`, virtual devices are skipped, so the app never reads its own virtual camera or mic: that
    would be a feedback loop. Windows's speaker-recording sources are always skipped, and so are its
    "Default ..." placeholders, which can stand for one of those.
    """
    from gi.repository import Gst
    Gst.init(None)
    monitor = Gst.DeviceMonitor()
    monitor.add_filter(device_class, None)
    monitor.start()
    def loopback(d):
        props = d.get_properties()
        return bool(props and props.has_field("wasapi2.device.loopback") and props.get_value("wasapi2.device.loopback"))

    devices = [d for d in monitor.get_devices() if not loopback(d)]
    monitor.stop()
    if real:
        devices = [d for d in devices if not any(v in d.get_display_name() for v in ("CABLE", "OBS", "Virtual"))
                   and not d.get_display_name().startswith("Default ")]
    devices.sort(key=lambda d: not (d.get_properties() and d.get_properties().has_field("device.default")
                                    and d.get_properties().get_value("device.default")))
    return devices


def find_mic():
    if WINDOWS:
        return windows_device("Audio/Source", "device")
    # Never read our own virtual mic: that would be a feedback loop.
    mic = pactl("get-default-source")
    return mic if mic and mic not in (MIC_NODE, f"{OUTPUT_NODE}.monitor") else None


def parse_sources(text):
    """[(name, description)] of the real mics in `pactl list sources` output."""
    mics, name = [], None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("Name: "):
            name = line[len("Name: "):]
        elif line.startswith("Description: ") and name:
            # Monitors record speakers, and our own mic would be a feedback loop.
            if not name.endswith(".monitor") and name != MIC_NODE:
                mics.append((name, line[len("Description: "):]))
            name = None
    return mics


def list_mics():
    """[(device id, name)] of the real mics, the default first on Windows."""
    if WINDOWS:
        return [(d.create_element(None).get_property("device"), d.get_display_name()) for d in windows_devices("Audio/Source")]
    return parse_sources(pactl("list", "sources"))


def find_webcam():
    if WINDOWS:
        return windows_device("Video/Source", "device-path")
    # shortcut: takes the first webcam, add a picker if a second one is ever attached
    cams = sorted(glob.glob("/dev/v4l/by-id/*video-index0"))
    return cams[0] if cams else None


def obs_camera_ready():
    """Windows: can we open OBS's virtual camera? Fails if OBS isn't installed or its own camera is on."""
    try:
        import pyvirtualcam
        with pyvirtualcam.Camera(width=320, height=180, fps=30, backend="obs"):
            return True
    except Exception:
        return False


def video_devices():
    """(path, driver, name) for each video device, asked directly: labels and sysfs links vary between systems."""
    import fcntl  # Linux only
    for path in sorted(glob.glob("/dev/video*")):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        try:
            info = bytearray(104)
            fcntl.ioctl(fd, VIDIOC_QUERYCAP, info)
        except OSError:
            continue
        finally:
            os.close(fd)
        field = lambda start, end: bytes(info[start:end]).split(b"\0")[0].decode(errors="replace")
        yield path, field(0, 16), field(16, 48)


def find_loopback(devices=None):
    """The first v4l2loopback device as (path, name), whatever it's labelled. Windows always uses OBS's."""
    if WINDOWS:
        return "obs", "OBS Virtual Camera"
    for path, driver, name in video_devices() if devices is None else devices:
        if driver == "v4l2 loopback":
            return path, name
    return None


def load_rubberband():
    """librubberband 3.0 or newer (formant control needs it), under whichever name this system uses."""
    for name in (*RUBBERBAND_NAMES, ctypes.util.find_library("rubberband")):
        if not name:
            continue
        try:
            lib = ctypes.CDLL(name)
        except OSError:
            continue
        if hasattr(lib, "rubberband_set_formant_scale"):
            return lib
    return None


def requirements():
    """(ok, what, effect if missing, PACKAGES key) for everything the app relies on."""
    results = []
    try:
        import gi
        for namespace, version in (("Gtk", "4.0"), ("Adw", "1"), ("Gst", "1.0"), ("GstApp", "1.0"), ("GstGL", "1.0")):
            gi.require_version(namespace, version)
        from gi.repository import Adw, Gst, Gtk  # noqa: F401
        ui = True
    except (ImportError, ValueError):
        ui = False
    results.append((ui, "GTK 4, libadwaita and PyGObject", "the app can't open", "ui"))
    if ui:
        Gst.init(None)
        missing = [name for name in GST_ELEMENTS if not Gst.ElementFactory.find(name)]
        results.append((not missing, "GStreamer plugins" + (f" (missing: {', '.join(missing)})" if missing else ""),
                        "camera or voice filters can't run", "gst"))
    if WINDOWS:
        if ui:
            results.append((obs_camera_ready(), "OBS Virtual Camera", "Discord can't see your filtered camera", "obs"))
            results.append((find_webcam() is not None, "Webcam", "there's nothing to filter. Plug one in", None))
            results.append((windows_device("Audio/Sink", "device", CABLE_INPUT) is not None, "VB-CABLE virtual mic",
                            "voice filters are off", "cable"))
            results.append((find_mic() is not None, "Microphone", "voice filters are off", None))
        results.append((load_rubberband() is not None, "Rubber Band", "the 7 voices that change pitch sound like Normal", None))
        return results
    loopback = find_loopback()
    results.append((loopback is not None, "Virtual camera" + (f" ({loopback[1]})" if loopback else ""),
                    f"Discord can't see your filtered camera. Load it with:  {LOOPBACK_SETUP}", "loopback"))
    caps_file = "/sys/module/v4l2loopback/parameters/exclusive_caps"
    if loopback and os.path.exists(caps_file) and "Y" not in open(caps_file).read():
        results.append((False, "Virtual camera set up for Discord (exclusive_caps=1)",
                        f"Discord may not list the camera. Reload it with:  sudo modprobe -r v4l2loopback && {LOOPBACK_SETUP}", None))
    results.append((find_webcam() is not None, "Webcam", "there's nothing to filter. Plug one in", None))
    pipewire = bool(shutil.which("pw-loopback") and shutil.which("pactl"))
    results.append((pipewire, "PipeWire tools (pw-loopback, pactl)", "voice filters are off", "pipewire"))
    if pipewire:
        results.append((find_mic() is not None, "Microphone", "voice filters are off", None))
    results.append((load_rubberband() is not None, "Rubber Band 3.0 or newer",
                    "the 7 voices that change pitch sound like Normal; the other 6 still work", "rubberband"))
    return results


def fix_text(package):
    """How to get a missing part: a download on Windows, or the install command for this Linux distribution."""
    if WINDOWS:
        return WINDOWS_HELP[package]
    fedora, debian = PACKAGES[package]
    try:
        with open("/etc/os-release") as f:
            release = f.read().lower()
    except OSError:
        release = ""
    if "fedora" in release:
        return f"sudo dnf install {fedora}"
    if "debian" in release or "ubuntu" in release:
        return f"sudo apt install {debian}"
    return f"Fedora: sudo dnf install {fedora}\nUbuntu/Debian: sudo apt install {debian}"


def report():
    print(f"\n{APP_NAME} requirements:")
    results = requirements()
    for ok, what, effect, package in results:
        print(f"  {'✓' if ok else '✗'} {what}")
        if not ok:
            print(f"      Without it {effect}.")
            if package:
                print("      " + fix_text(package).replace("\n", "\n      "))
    print("\nEverything's ready." if all(ok for ok, *_ in results) else "\nInstall what's marked ✗, then run this again.")


def desktop_quote(path):
    # Desktop-entry rules: \"\`$ and backslash escaped inside quotes, % doubled.
    escaped = {"\"": "\\\"", "`": "\\`", "$": "\\$", "\\": "\\\\\\\\", "%": "%%"}
    return '"' + "".join(escaped.get(ch, ch) for ch in path) + '"'


def install_paths(home=None):
    home = home or os.path.expanduser("~")
    return (os.path.join(home, ".local", "bin", "redbarn-studio"),
            os.path.join(home, ".local", "share", "icons", "hicolor", "scalable", "apps", f"{APP_ID}.svg"),
            os.path.join(home, ".local", "share", "applications", f"{APP_ID}.desktop"))


def refresh_menus(home=None):
    home = home or os.path.expanduser("~")
    for command in (["update-desktop-database", os.path.join(home, ".local", "share", "applications")],
                    ["gtk-update-icon-cache", "-q", "-t", "-f", os.path.join(home, ".local", "share", "icons", "hicolor")]):
        if shutil.which(command[0]):
            subprocess.run(command, capture_output=True)


def install(home=None):
    program, icon, launcher = install_paths(home)
    for path in (program, icon, launcher):
        os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.realpath(__file__) != os.path.realpath(program):
        shutil.copyfile(__file__, program)
    os.chmod(program, 0o755)
    with open(icon, "w") as f:
        f.write(ICON_SVG)
    with open(launcher, "w") as f:
        f.write(f"""[Desktop Entry]
Type=Application
Name={APP_NAME}
Comment=Cinematic camera looks, voice filters and a soundboard for Discord and other apps
Exec={desktop_quote(program)}
Icon={APP_ID}
Categories=AudioVideo;Video;
StartupWMClass={APP_ID}
Terminal=false
""")
    refresh_menus(home)
    print(f"Installed {APP_NAME}. Open it from your app menu.")
    report()
    print(f"\nIn Discord, under Settings > Voice & Video, choose the virtual camera and {MIC_NAME}.\n"
          f"Keep {APP_NAME} open while you use them.")


def uninstall(home=None):
    for path in install_paths(home):
        if os.path.exists(path):
            os.remove(path)
    refresh_menus(home)
    print(f"Removed {APP_NAME} from your app menu.")


