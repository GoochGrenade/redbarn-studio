# One shader with a mode uniform: glshader ignores new fragment source while
# playing, and restarting the pipeline would drop the camera from Discord.
SHADER = """varying vec2 v_texcoord;
uniform sampler2D tex;
uniform float time;
uniform float mode;

const vec2 PX = vec2(1.0 / 1280.0, 1.0 / 720.0);

float rand(vec2 p) {
  return fract(sin(dot(p, vec2(12.9898, 78.233)) + fract(time) * 311.7) * 43758.5453);
}
float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
float grain(vec2 uv, float amount) { return (rand(uv) - 0.5) * amount; }
float vignette(vec2 uv, float amount) {
  vec2 d = uv - 0.5;
  return clamp(1.0 - dot(d, d) * 2.0 * amount, 0.0, 1.0);
}
float scanlines(vec2 uv, float lines, float amount) {
  return 1.0 - amount * step(0.5, fract(uv.y * lines));
}
vec3 get(vec2 uv) { return texture2D(tex, uv).rgb; }

vec3 night_vision(vec2 uv) {
  float g = pow(luma(get(uv)), 0.6) * 1.5 + grain(uv, 0.22);
  return vec3(0.08, 1.0, 0.14) * g * vignette(uv, 1.4);
}
vec3 grainy_film(vec2 uv) {
  vec3 c = mix(vec3(0.07, 0.06, 0.05), vec3(1.0, 0.95, 0.85), get(uv));
  float flicker = 1.0 + 0.025 * sin(time * 37.0);
  return (c + grain(uv, 0.16)) * flicker * vignette(uv, 0.8);
}
vec3 hi_def(vec2 uv) {
  vec3 c = get(uv);
  vec2 o = PX * 1.5;
  vec3 blur = (get(uv + vec2(o.x, 0.0)) + get(uv - vec2(o.x, 0.0))
             + get(uv + vec2(0.0, o.y)) + get(uv - vec2(0.0, o.y))) * 0.25;
  c += (c - blur) * 1.3;
  c = (c - 0.5) * 1.15 + 0.5;
  return mix(vec3(luma(c)), c, 1.25);
}
vec3 webcam_2008(vec2 uv) {
  vec2 grid = vec2(320.0, 180.0);
  vec3 c = get((floor(uv * grid) + 0.5) / grid);
  c = floor(c * 20.0 + 0.5) / 20.0;
  c = pow(c, vec3(0.8)) * 1.15 * vec3(0.92, 1.0, 1.08);
  return c + grain(uv, 0.03);
}
vec3 vhs(vec2 uv) {
  uv.x += sin(uv.y * 30.0 + time * 3.0) * 0.0015;
  float band = abs(uv.y - fract(time * 0.13));
  if (band < 0.02) uv.x += 0.012;
  vec3 c = vec3(get(uv + vec2(0.004, 0.0)).r, get(uv).g, get(uv - vec2(0.004, 0.0)).b);
  c = mix(vec3(luma(c)), c, 0.8);
  c += grain(uv, band < 0.02 ? 0.35 : 0.06);
  return c * scanlines(uv, 240.0, 0.12);
}
vec3 noir(vec2 uv) {
  float g = smoothstep(0.1, 0.85, luma(get(uv))) + grain(uv, 0.1);
  return vec3(g) * vignette(uv, 1.0);
}
vec3 cctv(vec2 uv) {
  vec3 c = get(uv);
  c = mix(vec3(luma(c)), c, 0.15) * vec3(0.92, 1.0, 0.96);
  c = (c - 0.5) * 1.2 + 0.5 + grain(uv, 0.12);
  return c * scanlines(uv, 288.0, 0.14) * vignette(uv, 1.3);
}
vec3 camcorder(vec2 uv) {
  vec2 o = PX * 1.2;
  vec3 c = (get(uv + vec2(o.x, 0.0)) + get(uv - vec2(o.x, 0.0))
          + get(uv + vec2(0.0, o.y)) + get(uv - vec2(0.0, o.y)) + get(uv) * 4.0) * 0.125;
  c.r = get(uv + vec2(0.0015, 0.0)).r;
  c = pow(c, vec3(0.9)) * vec3(1.06, 1.0, 0.92) + grain(uv, 0.05);
  c *= scanlines(uv, 480.0, 0.08);
  vec2 d = abs(uv - 0.5);
  bool arm_x = abs(d.y - 0.484) < 0.002 && d.x > 0.43 && d.x < 0.485;
  bool arm_y = abs(d.x - 0.485) < 0.0012 && d.y > 0.40 && d.y < 0.486;
  return arm_x || arm_y ? vec3(0.95) : c;
}
vec3 thermal(vec2 uv) {
  vec2 o = PX * 3.0;
  float t = luma(get(uv) + get(uv + o) + get(uv - o) + get(uv + vec2(o.x, -o.y))) * 0.25;
  t = pow(clamp(t, 0.0, 1.0), 0.7);
  vec3 c = mix(vec3(0.02, 0.0, 0.25), vec3(0.6, 0.0, 0.7), smoothstep(0.0, 0.33, t));
  c = mix(c, vec3(1.0, 0.35, 0.0), smoothstep(0.33, 0.66, t));
