    def apply_settings(self, saved):
        # Checked one by one: the file is hand-editable, so any value may be missing or the wrong type.
        if isinstance(saved.get("look"), str) and saved["look"] in LOOKS:
            self.look_menu.set_selected(LOOKS.index(saved["look"]))
        if isinstance(saved.get("mic"), str) and saved["mic"] in [name for _, name in self.mics]:
            self.mic_menu.set_selected([name for _, name in self.mics].index(saved["mic"]) + 1)
        if isinstance(saved.get("voice"), str) and saved["voice"] in VOICES:
            self.voice_menu.set_selected(list(VOICES).index(saved["voice"]))
        for key, row in (("mirror", self.mirror), ("flip", self.flip_camera), ("dark", self.dark)):
            if isinstance(saved.get(key), bool):
                row.set_active(saved[key])
        if isinstance(saved.get("sound_level"), (int, float)):  # renamed in 1.1.1: older "volume" values used a louder scale
            self.volume.set_value(saved["sound_level"])
        if isinstance(saved.get("my_sound_level"), (int, float)):
            self.my_volume.set_value(saved["my_sound_level"])

    def current_settings(self):
        return {"look": self.look, "mic": self.mic_choice, "voice": list(VOICES)[self.voice_menu.get_selected()], "mirror": self.mirror.get_active(),
                "flip": self.flip_camera.get_active(), "dark": self.dark.get_active(), "sound_level": round(self.volume.get_value(), 2),
                "my_sound_level": round(self.my_volume.get_value(), 2)}

