# Written in GLSL 1.10 style; attach_shader adds the version line and shims each driver needs.
VERTEX_SHADER = """attribute vec4 a_position;
attribute vec2 a_texcoord;
varying vec2 v_texcoord;
void main() { gl_Position = a_position; v_texcoord = a_texcoord; }
"""
GL_VERTEX_SHADER, GL_FRAGMENT_SHADER = 0x8B31, 0x8B30


def attach_shader(fx):
    """Build the looks once the OpenGL context exists, with both shader stages on that context's GLSL version.

    Drivers reject a vertex/fragment version mismatch (Windows core-profile drivers do), and glshader then
    silently passes video through unfiltered, so the version can't be left to GStreamer's default vertex stage.
    """
    def build(element):
        context = element.get_property("context")
        api = context.get_gl_api()
        if api & GstGL.GLAPI.GLES2:
            version, profile, vertex_head, fragment_head = 100, GstGL.GLSLProfile.ES, "", "precision highp float;\n"
        elif api & GstGL.GLAPI.OPENGL3:
            version, profile = 150, GstGL.GLSLProfile.CORE
            vertex_head = "#define attribute in\n#define varying out\n"
            fragment_head = "#define varying in\n#define texture2D texture\nout vec4 frag_color;\n#define gl_FragColor frag_color\n"
        else:
            version, profile, vertex_head, fragment_head = 110, GstGL.GLSLProfile.NONE, "", ""
        version = GstGL.GLSLVersion(version)
        top = f"#version {GstGL.glsl_version_profile_to_string(version, profile)}\n"
        shader = GstGL.GLShader.new(context)
        for kind, head, body in ((GL_VERTEX_SHADER, vertex_head, VERTEX_SHADER), (GL_FRAGMENT_SHADER, fragment_head, SHADER)):
            shader.compile_attach_stage(GstGL.GLSLStage.new_with_string(context, kind, version, profile, top + head + body))
        shader.link()
        return shader

    fx.connect("create-shader", build)


