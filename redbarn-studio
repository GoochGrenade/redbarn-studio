    def set_status(self, pill, level, text, problem=None):
        pill.set_text(f"● {text}")
        pill.set_css_classes(["pill", level])
        self.problems[pill] = problem
        problems = [p for p in self.problems.values() if p]
        self.banner.set_title(" ".join(problems))
        self.banner.set_revealed(bool(problems))

    def camera_off(self, reason):
        # Shown on the camera-off screen, so not repeated in the banner.
        self.set_status(self.status, "stopped", "Camera off")
        self.camera_off_page.set_description(GLib.markup_escape_text(reason))
        self.stage.set_visible_child_name("off")

    def stop_camera(self):
        if not self.pipeline:
            return
        self.pipeline.get_bus().remove_signal_watch()
        stop(self.pipeline)
        if getattr(self.pipeline, "virtual_camera", None):
            self.pipeline.virtual_camera.close()
        self.pipeline = None

    def start(self):
        self.stop_camera()  # Try Again after an error: the old pipeline still holds the devices
        cam, loopback = find_webcam(), find_loopback()
        if not cam:
            self.camera_off("No webcam found. Plug it in, then click Try Again.")
            return
        if not loopback:
            self.camera_off("The virtual camera isn't set up. Setup & Help shows how to add it.")
            return
        loopback_path, loopback_name = loopback
        self.camera_group.set_description(f"Select '{GLib.markup_escape_text(loopback_name)}' as your camera source.")
        try:
            self.pipeline = build_camera_pipeline(cam, loopback_path)
        except GLib.Error as e:
            self.camera_off(f"Couldn't set up video: {e.message}")
            return
        except RuntimeError as e:  # Windows: OBS's virtual camera is missing or busy
            self.camera_off(f"Couldn't start the virtual camera: {e} {WINDOWS_HELP['obs']}")
            return
        self.pipeline.get_by_name("preview").connect("new-sample", self.on_preview)
        bus = self.pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_error)
        self.pipeline.set_state(Gst.State.PLAYING)
        if not self.ticking:  # one timer for the app's life: a second would make the dot blink twice as fast
            self.ticking = GLib.timeout_add(500, self.tick)
        self.stage.set_visible_child_name("live")
        self.set_status(self.status, "live", "Camera live")

    def start_voice(self):
        # Separate from the camera on purpose: a mic problem must not stop the video, or the reverse.
        try:
            self.virtual_mic, output = start_virtual_mic()
            self.mics = list_mics()
        except (OSError, subprocess.SubprocessError) as e:
            self.voice_off(f"Voice filters are off: {e}")
            return
        if not output:
            help_text = f" {WINDOWS_HELP['cable']}" if WINDOWS else ""
            self.voice_off(f"Couldn't create the virtual mic, so voice filters are off.{help_text}")
            return
        self.sound_output = output
        self.show_mics()
        self.restart_voice(find_mic())
        GLib.timeout_add_seconds(1, self.check_mic)

    def restart_voice(self, mic):
        """Read from another mic. Only the voice pipeline is rebuilt: apps using the virtual mic keep it."""
        if self.voice_pipeline:
            self.voice_pipeline.get_bus().remove_signal_watch()
            stop(self.voice_pipeline)
            self.voice_pipeline = None
        self.mic_id = mic
        # Only Automatic needs saying which mic it found; a picked mic is already shown in the menu.
        automatic = self.mic_choice is None
        self.mic_menu.set_subtitle(GLib.markup_escape_text(f"Using {self.mic_name(mic)}") if mic and automatic else "")
        if not mic:
            self.voice_off("No microphone found, so voice filters are off. Plug one in and it'll be picked up.")
            return
        try:
            self.voice_pipeline = build_voice_pipeline(mic, self.sound_output)
        except GLib.Error as e:
            self.voice_off(f"Voice filters are off: {e.message}")
            return
        bus = self.voice_pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_voice_error)
        self.voice_pipeline.get_by_name("mic").get_static_pad("src").add_probe(Gst.PadProbeType.BUFFER, self.on_mic_audio)
        set_voice(self.voice_pipeline, list(VOICES)[self.voice_menu.get_selected()])
        self.last_mic_audio = time.monotonic()
        self.voice_pipeline.set_state(Gst.State.PLAYING)
        for row in (self.voice_menu, self.monitor):
            row.set_sensitive(True)
        self.set_status(self.voice_status, "live", "Mic live")

    def mic_name(self, mic):
        return next((name for device, name in self.mics if device == mic), mic)

    def show_mics(self):
        """Refill the Microphone menu from self.mics, keeping the current choice selected."""
        # Never called from on_mic_choice: a model change there re-fires the selection, in a loop.
        self.updating_mics = True
        names = [name for _, name in self.mics]
        self.mic_menu.set_model(Gtk.StringList.new(["Automatic", *names]))
        self.mic_menu.set_selected(names.index(self.mic_choice) + 1 if self.mic_choice in names else 0)
        self.updating_mics = False

    def on_mic_choice(self, menu, _param):
        index = menu.get_selected()
        if self.updating_mics or not self.sound_output or index > len(self.mics):
            return
        choice = self.mics[index - 1][1] if index else None
        if choice == self.mic_choice:
            return
        self.mic_choice = choice
        self.restart_voice(self.mics[index - 1][0] if index else find_mic())

    def poll_mics(self):
        # In a thread: listing Windows devices can take long enough to stutter the window.
        try:
            mics, default = list_mics(), find_mic()
        except (OSError, subprocess.SubprocessError):
            mics, default = self.mics, self.mic_id
        GLib.idle_add(self.on_mics_polled, mics, default)

    def on_mics_polled(self, mics, default):
        self.polling = False
        if mics != self.mics:
            self.mics = mics
            self.show_mics()
        if self.mic_choice is None and default != self.mic_id:
            self.restart_voice(default)
            if default:
                self.toasts.add_toast(Adw.Toast(title=f"Now using {self.mic_name(default)}"))
        return False

    def on_mic_audio(self, _pad, _info):
        self.last_mic_audio = time.monotonic()
        return Gst.PadProbeReturn.OK

    def check_mic(self):
        if self.monitor_process and not running(self.monitor_process):
            self.monitor.set_active(False)
        self.mic_poll = (self.mic_poll + 1) % 2
        if not self.mic_poll and not self.polling:  # every 2 seconds: a headset may have been plugged in
            self.polling = True
            threading.Thread(target=self.poll_mics, daemon=True).start()
        # A missing mic raises no error: pulsesrc just waits, and Discord would get silence.
        if not self.voice_pipeline:
            return True
        voice = VOICES[list(VOICES)[self.voice_menu.get_selected()]]
        if time.monotonic() - self.last_mic_audio > 2:
            self.set_status(self.voice_status, "warn", "No mic audio", MIC_LOST)
        elif self.voice_pipeline.shifter.lib is None and ("pitch" in voice or "formant" in voice):
            self.set_status(self.voice_status, "warn", "Voice unavailable", RUBBERBAND_MISSING)
        else:
            self.set_status(self.voice_status, "live", "Mic live")
        return True

    def voice_off(self, reason):
        self.mic_menu.set_sensitive(bool(self.sound_output))  # with the virtual mic up, another mic can still be picked
        self.voice_menu.set_sensitive(False)
        self.monitor.set_active(False)
        self.monitor.set_sensitive(False)
        self.set_status(self.voice_status, "stopped", "Mic off", reason)

    def on_preview(self, sink):
        buffer = sink.emit("pull-sample").get_buffer()
        GLib.idle_add(self.show_preview, GLib.Bytes.new(buffer.extract_dup(0, buffer.get_size())))
        return Gst.FlowReturn.OK

    def show_preview(self, pixels):
        self.picture.set_paintable(Gdk.MemoryTexture.new(
            PREVIEW_WIDTH, PREVIEW_HEIGHT, Gdk.MemoryFormat.R8G8B8A8, pixels, PREVIEW_WIDTH * 4))
