  float wear = fbm(px * 0.035 + seed + 50.0);
  float seam = smoothstep(0.0, 0.035, fx) * smoothstep(0.0, 0.035, 1.0 - fx);

  vec3 paint = vec3(0.55, 0.11, 0.08) * (0.82 + 0.28 * barn_noise(vec2(plank, 3.0) + seed)) * (0.72 + 0.45 * grain);
  paint = mix(paint, paint * 1.18 + vec3(0.05, 0.03, 0.03), smoothstep(0.45, 0.0, d.y) * 0.5);  // sun-faded top
  vec3 bare = vec3(0.5, 0.44, 0.37) * (0.7 + 0.45 * grain);
