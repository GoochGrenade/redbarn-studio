            row = Adw.ActionRow(title=GLib.markup_escape_text(what), subtitle=GLib.markup_escape_text(subtitle),
                                subtitle_selectable=True, subtitle_lines=0)
            row.add_prefix(Gtk.Image(icon_name=ICONS["ok" if ok else "warning"], css_classes=["success" if ok else "warning"]))
