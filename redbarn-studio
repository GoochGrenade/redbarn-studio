def build_camera_pipeline(cam, loopback):
    output = ("t. ! queue ! videoconvert ! video/x-raw,format=RGB ! appsink name=out emit-signals=true sync=false drop=true max-buffers=2 "
              if WINDOWS else f"t. ! queue ! v4l2sink name=out device={loopback} sync=false ")
    pipeline = Gst.parse_launch(
        f"{WEBCAM_SOURCE} ! {FILTER_CHAIN} ! tee name=t "
        f"{output}"
        # appsink, not gtk4paintablesink: that shares GTK's Wayland GL context with
        # glshader, which brings back the blank-frame path GST_GL_WINDOW=x11 avoids.
        "t. ! queue leaky=downstream max-size-buffers=2 ! videoscale ! videoconvert "
        f"! video/x-raw,format=RGBA,width={PREVIEW_WIDTH},height={PREVIEW_HEIGHT} "
        "! appsink name=preview sync=false drop=true max-buffers=1 emit-signals=true"
    )
    if cam:
        pipeline.get_by_name("cam").set_property(WEBCAM_DEVICE, cam)
    if WINDOWS:
        attach_virtual_camera(pipeline)
    fx = pipeline.get_by_name("fx")
    attach_shader(fx)
    set_look(fx, LOOKS[0])
    return pipeline


def attach_virtual_camera(pipeline):
    """Windows: send each finished frame to OBS's virtual camera. Raises if OBS isn't installed or is using it."""
    import numpy
    import pyvirtualcam
    camera = pipeline.virtual_camera = pyvirtualcam.Camera(width=1280, height=720, fps=30,
                                                           fmt=pyvirtualcam.PixelFormat.RGB, backend="obs")

    def send(sink):
        buffer = sink.emit("pull-sample").get_buffer()
        camera.send(numpy.frombuffer(buffer.extract_dup(0, buffer.get_size()), numpy.uint8).reshape(720, 1280, 3))
        return Gst.FlowReturn.OK

    pipeline.get_by_name("out").connect("new-sample", send)


def error_hint(message):
    _, debug = message.parse_error()
    source = message.src.get_name()
    if source == "out":
        return f"Can't write to the virtual camera. Close OBS Virtual Camera, then reopen {APP_NAME}."
    if source == "cam":
        return f"The webcam stopped. Check it's plugged in and not in use, then reopen {APP_NAME}."
    return f"Video error: {message.parse_error()[0].message} ({debug})"


